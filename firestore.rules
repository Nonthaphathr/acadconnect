rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'nonthaphathr@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // รายการระบบ: ทุกคนอ่านได้ เฉพาะผู้ดูแลเขียนได้
    match /systems/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // สถิติการคลิก: ทุกคนอ่านได้ และเพิ่มได้ทีละ 1 เท่านั้น
    match /stats/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['clicks'])
                    && request.resource.data.clicks == 1;
      allow update: if request.resource.data.keys().hasOnly(['clicks'])
                    && request.resource.data.clicks == resource.data.clicks + 1;
      allow delete: if isAdmin();
    }
  }
}
